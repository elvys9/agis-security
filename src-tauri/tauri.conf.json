{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThreatLens",
  "version": "0.1.2",
  "identifier": "com.aegis.security",
  "mainBinaryName": "threatlens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"ThreatLens","width":1280,"height":840,"minWidth":900,"minHeight":620}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'"}
  },
  "bundle": {
    "active": true,
    "resources": {"llm-assets/": "llm/"},
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "ThreatLens — unsigned experimental release",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type":"downloadBootstrapper","silent":true},
      "nsis": {"installMode":"perMachine","languages":["Italian","English"],"displayLanguageSelector":true,"startMenuFolder":"ThreatLens","installerHooks":"../installer/hooks.nsh"},
      "wix": {"language":"it-IT","upgradeCode":"EDDE36E9-A507-4BB4-A420-209DF1098AC6"}
    }
  }
}
